# Obtén tu API key gratuita en Google AI Studio: https://aistudio.google.com/apikey
# En Vercel: Project Settings -> Environment Variables -> agrega GEMINI_API_KEY (Production, Preview, Development)
GEMINI_API_KEY=
# Modelo por defecto en capa gratuita (respaldo automático: gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-3.6-flash
